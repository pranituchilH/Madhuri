# Server
PORT=5050
NODE_ENV=development
# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=madhuri
DB_PASSWORD=change_me
DB_NAME=madhuri_sarees
# true for hosted MySQL such as TiDB Cloud
DB_SSL=false

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Razorpay (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary (cloudinary://<api_key>:<api_secret>@<cloud_name>) — leave empty to store uploads on disk
CLOUDINARY_URL=

# Store rules (INR)
SHIPPING_FEE=99
FREE_SHIPPING_ABOVE=1999
COD_ENABLED=true

# Seed admin account
ADMIN_NAME=Madhuri Admin
ADMIN_EMAIL=admin@madhurisarees.com
ADMIN_PASSWORD=Admin@123
