{
  "name": "madhuri-sarees-api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Madhuri Sarees e-commerce",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/db/setup.js",
    "db:seed": "node src/db/setup.js --seed",
    "db:migrate": "node src/db/migrate.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "razorpay": "^2.9.5"
  }
}
